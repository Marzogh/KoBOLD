{
  "name": "kobold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Kobo Tailscale preparation and recovery wizard",
  "scripts": {
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py' && python3 tools/test-provenance.py",
    "build": "python3 tools/build.py",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory web",
    "format:check": "python3 tools/format_source.py --check",
    "export:source": "python3 tools/export_public.py --output cache/public-source",
    "export:site": "python3 tools/export_public.py --kind site --output cache/public-site"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marzogh/KoBOLD.git"
  },
  "bugs": {
    "url": "https://github.com/Marzogh/KoBOLD/issues"
  }
}
